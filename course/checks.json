    },
    "10_custom_matrix": {"mode":"visual"},
    "11_material_channels": {
      "mode":"visual_contract",
      "contracts":{"required":[
        {"label":"暴露 roughness_value","pattern":"uniform\\s+float\\s+roughness_value"},
        {"label":"暴露 metallic_value","pattern":"uniform\\s+float\\s+metallic_value"}
      ]}
    },
    "12_lambert": {"mode":"visual"},
    "13_dot_probe": {"mode":"visual"},
