    },
    "18_hemisphere_include": {
      "mode":"visual_contract",
      "contracts":{"required":[{"label":"引用共享光照 include","pattern":"#include\\s+\"res://shared/shaders/atlas_lighting\\.gdshaderinc\""}]}
    },
    "19_normal_mapping": {"mode":"visual"},
    "20_sdf_shapes": {"mode":"visual"},
    "21_procedural_character": {"mode":"visual"},
    "22_time_animation": {"mode":"visual"},
    "23_vertex_deformation": {"mode":"visual"},
    "24_ui_sweep": {"mode":"visual"},
    "25_rotation_matrix": {"mode":"visual"},
    "26_quaternion": {
      "mode":"visual_manual",
      "manual_checklist":["改变旋转轴后仍保持刚体形状","角度正负变化时旋转方向相反"]
    },
    "27_gameboy_post": {"mode":"visual"},
    "28_shadertoy_port": {"mode":"visual"},
    "29_distance_fade": {
      "mode":"visual_manual",
      "visual":{"mean_error":0.003,"max_bad_pixel_ratio":0.012},
      "manual_checklist":["相机靠近时物体更不透明","相机越过 fade_far 后几乎不可见"]
    },
    "30_ray_marching": {"mode":"visual","visual":{"mean_error":0.008,"max_bad_pixel_ratio":0.04}},
    "31_stencil_portal": {
      "mode":"manual_contract",
      "contracts":{"required":[{"label":"读取模板值 1","pattern":"stencil_mode\\s+read\\s*,\\s*compare_equal\\s*,\\s*1"}]},
