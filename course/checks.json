    },
    "32_signal_storm": {
      "mode":"visual_manual",
      "visual":{"mean_error":0.008,"max_bad_pixel_ratio":0.04},
      "manual_checklist":["顶点脉动、边缘光和溶解同时可辨认","调节 dissolve_threshold 时边缘连续推进","能够说明每项计算所处的坐标空间"]
    }
